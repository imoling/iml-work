# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Dependency directories
**/node_modules/
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Output directories
# ⚠️ 不加 **/build/：客户端与 FDE 的 build/ 是 electron-builder 的**源资产**
#（icon.png、afterPack.cjs 签名钩子），忽略了换台机器就打不了包。
**/dist/
**/dist-electron/
**/out/
**/target/

# electron-builder 打包产物（dmg/exe/blockmap/win-unpacked…，1GB+）
**/release/

# IDEs and editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS metadata
.DS_Store
Thumbs.db

# Local env config (保留 .env.example 作为模板)
**/.env
**/.env.local
!**/.env.example

# 一键启动脚本的运行日志
.devlogs/

# Workspace generated documents
**/documents/
**/sqlite.db
**/iml-work.db
**/iml-work.db-journal
**/iml-work.db-shm
**/iml-work.db-wal
# 多账号分库（iml-work-user-<id>.db 及其 -journal/-shm/-wal）
**/iml-work-user-*.db*
docs/

# 部署打包脚本在仓库根落的前端 tar（scp 上服务器用，产物不进仓）
/dist-*.tar.gz

# playwright-cli 冒烟测试的截图/快照
.playwright-cli/

# Claude Code 本地会话文件（个人配置，不共享）
.claude/settings.local.json
.claude/scheduled_tasks.lock

# 客户端运行时认领分身时落盘的技能文件（SKILL.md），非源码，属产物
iml-work-client/skills/

# 沙箱离线 wheel 包：放本地项目、供离线 build，但不进仓（体积大）。保留 .gitkeep 占位目录。
iml-work-admin/admin-backend/docker/sandbox/wheels/*
!iml-work-admin/admin-backend/docker/sandbox/wheels/.gitkeep

# 离线镜像 tar（docker save 的沙箱/docling 镜像）：放本地项目供部署 docker load，太大不进仓。
iml-work-admin/admin-backend/docker/offline/*.tar
!iml-work-admin/admin-backend/docker/offline/README.md

# searxng 实际配置（含随机 secret_key）由 docker-services.sh 首次 up 生成，只留模板进仓
iml-work-admin/admin-backend/docker/searxng/config/

# 会话生成的交付物（PPT/Excel/线框图），个人产物，非源码，不进仓
/*.pptx
/*.xlsx
/客户端×后台功能矩阵线框图*

# 发布视频工程（Remotion）：宣发物料非产品源码，且含配音 mp3 与成片，本地保留不进仓
/iml-work-video/

# 内部工作指令（Claude Code 项目说明），本地保留、不进开源仓
/CLAUDE.md
# 内部运维手册（含部署主机等），本地保留、不进开源仓
/RUNBOOK.md
.claude/

# 浏览器登录态/凭据文件（安全红线：凭证绝不入库）——Playwright storageState、各类 *-auth.json
*-auth.json
storage-state*.json
# 沙箱镜像的本机收集字体（苹方/雅黑，版权字体不入库；.gitkeep 保留目录）
iml-work-admin/admin-backend/docker/sandbox/fonts/*
!iml-work-admin/admin-backend/docker/sandbox/fonts/.gitkeep
# 离线语音模型（55MB+ 二进制，运维按 RUNBOOK 放置，不入库）
iml-work-admin/admin-backend/models/
# 沙箱镜像 tar 等平台托管资源（几百MB 二进制，不入库）
iml-work-admin/admin-backend/resources/
# 版权字体（苹方/雅黑）不入库：build_sandbox 从本机收集（见 scripts/docker-services.sh）
iml-work-admin/admin-backend/docker/sandbox/fonts/

# 本地项目工作区（个人产物，不进仓）
/projects/
